# 複製成 .env 後依需要修改（.env 不會上傳 GitHub）。
# docker compose 的 api、worker，以及在本機執行的後端（uv run）都會讀取。

# 模擬模式的播放速度：1 為 1× 時間軸（約 15 秒一個任務），0 為不等待
SIM_SPEED=1
# 模擬模式：第一輪刻意失誤，展示合規審查與 Query Rewriting
SIM_FIRST_ROUND_FAIL=true
# 模擬模式：每一輪都失誤，展示「需人工審核」
SIM_FORCE_ALL_FAIL=false
# 任務 id 使用的時區
TIMEZONE=Asia/Taipei
# 商品照去背的模型：birefnet-general（預設，效果最好，Docker 實測每張約 13 秒）、birefnet-general-lite（較快，邊緣較粗糙），
# 或不需要模型的 sim（測試用）。第一次啟動時下載模型（約 1 GB），去背時 worker 約使用 8 GB 記憶體（Docker 實測尖峰約 7.6 GiB；平常約 2 GB）。
# 兩個模型都需要 Docker 的記憶體上限約 10 GB 以上（Docker Desktop 的 Settings → Resources，WSL2 則改 .wslconfig）。birefnet-general-lite 較快、下載量較小（約 224 MB），但尖峰只低約 0.75 GB（本機實測 5.75 GB 對 6.50 GB），改用它解決不了記憶體不足；16 GB 的電腦只用去背時請把上限調到約 10 GB（同時使用 RAG 見下方 RAG_MODE 的說明），WSL2 預設是一半的記憶體（16 GB 的電腦是 8 GB），不夠用。
CUTOUT_MODEL=birefnet-general
# RAG：bge（預設，BGE-M3 向量化＋bge-reranker-v2-m3 Rerank＋Chroma 向量庫；第一次啟動時下載模型約 1.2 GB，存在 models volume；
# worker 啟動時的同步發現索引有差異（例如第一次啟動或 Chroma 重建）時就會載入；沒有差異時，第一次檢索才載入），
# 或不需要模型與 Chroma 的 sim（模擬檢索，測試與 live E2E 使用；上傳的手冊與歷史回寫只寫入 PostgreSQL）。
# 記憶體：模型載入後常駐，worker 約再多用 1.7 GB（Docker 實測 1.75 GB）。與去背的尖峰相加約 10 GB，
# Docker 的記憶體上限請比上面去背的建議再多留約 2 GB（例如 12 GB）。
# 16 GB 的電腦同時使用去背與 RAG 時，Docker 上限請設約 12 GB；不夠時改用 RAG_MODE=sim。
RAG_MODE=bge
# 向量庫（Chroma）的網址，只有在本機執行後端（uv run）時使用：預設連 docker compose 的 chroma（127.0.0.1:8001）。
# Docker 內的 api 與 worker 固定使用 http://chroma:8000（docker-compose.yml）。
# CHROMA_URL=http://127.0.0.1:8001
# 審查：composer（預設，composer 在伺服器端繪製審查用海報，存到 data/jobs/{任務 id}/{候選 id}.png，從像素量出品牌主色後審查，分數不加抖動），
# 或 sim（不畫圖，審查結果與 mock 模式相同）。api（系統狀態）與 worker 要用同一個值。
# 在本機執行 worker 時，composer 要有海報字型：先在 web/ 執行 npm run fonts（約 29 MB），再 npm run composer。
# 字型放在別的資料夾時，在執行 composer 的視窗設定環境變數 POSTER_FONTS_DIR（composer 不讀這個檔案；Docker 的字型在建置時下載）。
REVIEW_MODE=composer
# 結束超過這麼多天的任務，worker 清理 data/jobs/ 裡的審查用海報與生成的背景（每張約 0.3–1 MB；啟動時與之後每天一次）。
# 歷史紀錄（選定的海報）用到的背景會保留；清理後，舊任務的任務透視看不到審查用海報。0 為不清理。
JOB_FILES_RETENTION_DAYS=30
# api 接受的主機名稱（JSON 陣列）：防止 DNS rebinding（惡意網頁把自己的網域解析到 127.0.0.1 後從瀏覽器呼叫 api）。
# 以其他名稱開啟前端（例如區網的 IP）時才要加，web/nginx.conf 的 server_name 也要一起加，再重新建置 web。
# ALLOWED_HOSTS=["127.0.0.1", "localhost"]

# ---------- Gemini（Agent 與 VLM 審查） ----------
# Agent 與 VLM 一起切換：gemini（預設，Gemini 拆解需求、構建 Prompt、Query Rewriting 與 VLM 審查）或 sim（模擬，不需要 key）。
# gemini 需要 REVIEW_MODE=composer（VLM 讀伺服器端繪製的審查用海報），設成 sim 時 api 與 worker 會啟動失敗並說明原因。
# api（需求拆解、系統狀態）與 worker 要用同一個值。
AGENT_MODE=gemini
# Gemini API key（Google AI Studio 建立）。只放在這個檔案，不要貼到其他地方；系統狀態只顯示末 4 碼。
# 沒有設定時服務照常啟動，系統狀態會顯示提示，需求拆解與新任務會被拒絕；或改用 AGENT_MODE=sim。
# 注意：免費方案的輸入（包括商品照與海報）可能被 Google 用來改善產品並由人工審閱，未發表的商品請用付費方案的 key。
GEMINI_API_KEY=
# 需求拆解、Prompt 構建、Query Rewriting 使用的模型
GEMINI_LLM_MODEL=gemini-3.8-flash
# VLM 審查使用的模型
GEMINI_VLM_MODEL=gemini-3.8-flash
# 每次請求的逾時（秒）
GEMINI_TIMEOUT_SECONDS=120
# 429、5xx、逾時時的重試次數（間隔 1、2、4 秒；429 有建議的等待時間時採用，最長 60 秒）
GEMINI_MAX_RETRIES=3
# 每個 worker 同時進行的 Gemini 呼叫數
GEMINI_CONCURRENCY=4
# 單一任務的 Gemini 費用上限（美元），0 為不設上限。上限在呼叫前檢查，最多超出並行中的呼叫的費用
GEMINI_JOB_BUDGET_USD=1
# 每月（台北時間）的 Gemini 費用上限（美元），0 為不設上限；含需求拆解。達到時新任務與需求拆解被拒絕
GEMINI_MONTHLY_BUDGET_USD=20
# Gemini 單價表，只有在本機執行後端（uv run）時使用：預設為 repo 根目錄的 pricing.yaml。
# Docker 內的 api 與 worker 固定使用 /app/pricing.yaml（docker-compose.yml 唯讀掛載）。
# PRICING_FILE=pricing.yaml

# ---------- ComfyUI（生圖） ----------
# 生圖：comfyui（預設，ComfyUI 依商品底圖生成背景，商品像素一律用原始去背圖）或 sim（程序化背景，不需要 GPU）。
# comfyui 需要 REVIEW_MODE=composer（商品底圖由 composer 產生），設成 sim 時 api 與 worker 會啟動失敗並說明原因。
# api（系統狀態）與 worker 要用同一個值。ComfyUI 的安裝與啟動見 comfyui/README.md。
IMAGE_MODE=comfyui
# ComfyUI 的位址：本機執行後端（uv run）時預設為 http://127.0.0.1:8188，Docker 內的 api 與 worker 預設為
# http://host.docker.internal:8188（docker-compose.yml）。ComfyUI 不在本機的 8188 埠時才設定，
# 設定後 Docker 與本機執行都會使用這個值（docker compose 也讀這個檔案的變數）。
# COMFYUI_URL=http://192.168.1.20:8188
# 每個 ComfyUI prompt 的逾時（秒），含排隊與第一次載入模型
COMFYUI_TIMEOUT_SECONDS=600
# 每個任務生圖結束後是否請 ComfyUI 卸載模型、釋放記憶體（下一個任務要重新載入，約多 10–30 秒）
COMFYUI_FREE_AFTER_JOB=false
# 生圖與商品去背互斥：16 GB 記憶體的筆電兩者同時執行會不夠；記憶體夠大時可以設為 false
MEMORY_LOCK=true
# workflow 與參數對照表，只有在本機執行後端時使用：預設為 repo 根目錄的 comfyui/workflows。
# Docker 內固定使用 /app/comfyui/workflows（docker-compose.yml 唯讀掛載）。
# COMFYUI_WORKFLOWS_DIR=comfyui/workflows
